{"w":"oganesson","def":{"en":"The chemical element (symbol Og) with atomic number 118. It is the heaviest known element. Highly radioactive, it does not occur naturally. Originally expected to be a noble gas, it is now predicted to be a reactive metallic solid, and a semiconductor or a post-transition metal."},"tr":{"ar":["أُوغَانِيسُون"],"hy":["օգանեսոն"],"bg":["оганесон"],"ca":["oganessó"],"cmn":["鿫"],"da":["oganesson"],"eo":["oganesono"],"fi":["oganesson"],"fr":["oganesson"],"ka":["ოგანესონი"],"de":["Oganesson"],"el":["ογκανέσσιο"],"hu":["oganeszon"],"is":["oganesson"],"ga":["óganasan"],"it":["oganesson"],"ja":["オガネソン"],"kk":["оганесон"],"ko":["오가네손"],"lv":["oganesons"],"mk":["оганесон"],"nb":["oganesson"],"nn":["oganesson"],"pl":["oganeson"],"pt":["oganésson","oganessônio"],"ru":["оганесон"],"sk":["oganesón"],"es":["oganesón"],"sv":["oganesson"],"uk":["оґанесон"],"vi":["oganesson"],"cy":["oganeson"]},"rom":{"ar":"ʔūḡānīsūn","hy":"ōganeson","bg":"oganeson","cmn":"ào","ka":"oganesoni","el":"ogkanéssio","ja":"oganeson","kk":"oganeson","ko":"oganeson","mk":"oganeson","ru":"oganeson","uk":"oganeson"},"ln":{"ar":"Arabic","hy":"Armenian","bg":"Bulgarian","ca":"Catalan","cmn":"Chinese Mandarin","da":"Danish","eo":"Esperanto","fi":"Finnish","fr":"French","ka":"Georgian","de":"German","el":"Greek","hu":"Hungarian","is":"Icelandic","ga":"Irish","it":"Italian","ja":"Japanese","kk":"Kazakh","ko":"Korean","lv":"Latvian","mk":"Macedonian","nb":"Norwegian Bokmål","nn":"Norwegian Nynorsk","pl":"Polish","pt":"Portuguese","ru":"Russian","sk":"Slovak","es":"Spanish","sv":"Swedish","uk":"Ukrainian","vi":"Vietnamese","cy":"Welsh"},"ipa":"/oʊɡəˈnɛsɒn/"}